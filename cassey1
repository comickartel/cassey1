<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minecraft AI Assistant</title>
    <!-- Google Fonts for a gaming/clean look -->
    <link href="https://googleapis.com" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Work Sans', sans-serif;
            background-color: #1a1a1a;
            background-image: radial-gradient(#2c2c2c 10%, transparent 10%);
            background-size: 20px 20px;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .chat-container {
            width: 100%;
            max-width: 600px;
            height: 80vh;
            background: #252525;
            border: 4px solid #4a4a4a;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        header {
            background: #3c3c3c;
            padding: 20px;
            text-align: center;
            border-bottom: 4px solid #1e1e1e;
        }

        header h1 {
            font-family: 'Press Start 2P', monospace;
            font-size: 1.3rem;
            color: #55ff55;
            text-shadow: 2px 2px #00aa00;
            margin-bottom: 8px;
        }

        header p {
            font-size: 0.9rem;
            color: #aaaaaa;
        }

        .chat-box {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
            background: #1e1e1e;
        }

        .message {
            padding: 12px 16px;
            border-radius: 6px;
            max-width: 80%;
            line-height: 1.4;
            word-wrap: break-word;
        }

        .user-message {
            background: #4a4a4a;
            align-self: flex-end;
            border-right: 4px solid #888888;
        }

        .ai-message {
            background: #2e4a2e;
            align-self: flex-start;
            border-left: 4px solid #55ff55;
        }

        .input-area {
            display: flex;
            padding: 15px;
            background: #252525;
            border-top: 4px solid #1e1e1e;
            gap: 10px;
        }

        input[type="text"] {
            flex: 1;
            background: #121212;
            border: 2px solid #4a4a4a;
            padding: 12px;
            color: #fff;
            font-size: 1rem;
            border-radius: 4px;
            outline: none;
        }

        input[type="text"]:focus {
            border-color: #55ff55;
        }

        button {
            background: #55ff55;
            color: #000;
            border: none;
            padding: 0 20px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
        }

        button:hover {
            background: #33cc33;
        }
    </style>
</head>
<body>

    <div class="chat-container">
        <header>
            <h1>MINECRAFT AI</h1>
            <p>Ask me anything about crafting, mobs, or redstone!</p>
        </header>

        <div class="chat-box" id="chatBox">
            <div class="message ai-message">
                Hello Steve! I am your AI companion. Ask me any Minecraft question!
            </div>
        </div>

        <div class="input-area">
            <input type="text" id="userInput" placeholder="How do I craft a netherite pickaxe?..." autofocus>
            <button id="sendBtn">Ask AI</button>
        </div>
    </div>

    <script>
        const chatBox = document.getElementById('chatBox');
        const userInput = document.getElementById('userInput');
        const sendBtn = document.getElementById('sendBtn');

        // IMPORTANT: Insert your actual OpenAI API Key between the quotes below
        const API_KEY = 'YOUR_OPENAI_API_KEY'; 

        sendBtn.addEventListener('click', handleSend);
        userInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleSend();
        });

        function handleSend() {
            const text = userInput.value.trim();
            if (!text) return;

            // Display user message
            appendMessage(text, 'user-message');
            userInput.value = '';

            // Display temporary "thinking" message
            const loadingId = appendMessage('Thinking...', 'ai-message');

            // Send question to AI
            fetchMinecraftAnswer(text, loadingId);
        }

        function appendMessage(text, className) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('message', className);
            messageDiv.innerText = text;
            chatBox.appendChild(messageDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
            
            const id = 'msg-' + Date.now();
            messageDiv.setAttribute('id', id);
            return id;
        }

        async function fetchMinecraftAnswer(question, loadingId) {
            const loadingMessageElement = document.getElementById(loadingId);

            // Warning validation if key isn't changed
            if (API_KEY === 'YOUR_OPENAI_API_KEY') {
                loadingMessageElement.innerText = "Error: Please open the index.html file in a code editor and paste your OpenAI API key into the API_KEY variable.";
                return;
            }

            try {
                const response = await fetch('https://openai.com', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${API_KEY}`
                    },
                    body: JSON.stringify({
                        model: 'gpt-4o-mini',
                        messages: [
                            { 
                                role: 'system', 
                                content: 'You are an absolute expert AI specialized exclusively in Minecraft. Answer any questions about recipes, game mechanics, strategies, updates, redstone, or lore perfectly, accurately, and concisely.' 
                            },
                            { role: 'user', content: question }
                        ],
                        temperature: 0.5
                    })
                });

                const data = await response.json();
                
                if (response.ok) {
                    const aiAnswer = data.choices[0].message.content;
                    loadingMessageElement.innerText = aiAnswer;
                } else {
                    loadingMessageElement.innerText = "Error: " + (data.error?.message || "Could not retrieve answer.");
                }

            } catch (error) {
                console.error(error);
                loadingMessageElement.innerText = "Oops! Connection to the AI failed.";
            }
            
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
</body>
</html>
