/* =========================================================
NEON PARTICLE BACKGROUND
========================================================= */

const canvas = document.getElementById("bg-canvas");
const ctx = canvas.getContext("2d");

let width;
let height;

function resizeCanvas() {
width = canvas.width = window.innerWidth;
height = canvas.height = window.innerHeight;
}

resizeCanvas();

window.addEventListener("resize", resizeCanvas);

const particles = [];

const particleCount =
window.innerWidth < 600 ? 45 : 90;

for (let i = 0; i < particleCount; i++) {

particles.push({

    x: Math.random() * width,
    y: Math.random() * height,

    radius: Math.random() * 2 + .5,

    vx: (Math.random() - .5) * .45,
    vy: (Math.random() - .5) * .45,

    color:
        Math.random() > .5
        ? "0,243,255"
        : "255,0,127"

});

}

function animateBackground() {

ctx.fillStyle = "#050510";

ctx.fillRect(0, 0, width, height);

particles.forEach(p => {

    p.x += p.vx;
    p.y += p.vy;

    if (p.x < 0 || p.x > width)
        p.vx *= -1;

    if (p.y < 0 || p.y > height)
        p.vy *= -1;

    ctx.beginPath();

    ctx.arc(
        p.x,
        p.y,
        p.radius,
        0,
        Math.PI * 2
    );

    ctx.fillStyle =
        `rgba(${p.color},.75)`;

    ctx.shadowBlur = 15;
    ctx.shadowColor =
        `rgb(${p.color})`;

    ctx.fill();

});

/* Connect nearby particles */

for (let i = 0; i < particles.length; i++) {

    for (let j = i + 1; j < particles.length; j++) {

        const a = particles[i];
        const b = particles[j];

        const dx = a.x - b.x;
        const dy = a.y - b.y;

        const distance =
            Math.sqrt(dx * dx + dy * dy);

        if (distance < 130) {

            const opacity =
                1 - distance / 130;

            ctx.beginPath();

            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);

            ctx.strokeStyle =
                `rgba(0,243,255,${opacity * .13})`;

            ctx.lineWidth = 1;

            ctx.stroke();
        }
    }
}

requestAnimationFrame(animateBackground);

}

animateBackground();

/* =========================================================
ELEMENTS
========================================================= */

const searchMode =
document.getElementById("search-mode");

const generateMode =
document.getElementById("generate-mode");

const searchPanel =
document.getElementById("search-panel");

const generator =
document.getElementById("generator");

const searchInput =
document.getElementById("search-input");

const searchBtn =
document.getElementById("search-btn");

const generateBtn =
document.getElementById("generate-btn");

const statusMsg =
document.getElementById("status-msg");

const contentGrid =
document.getElementById("content-grid");

const lyricsContent =
document.getElementById("lyrics-content");

const songTitle =
document.getElementById("song-title");

const songArtist =
document.getElementById("song-artist");

const videoFrame =
document.getElementById("video-frame");

/* =========================================================
MODE SWITCHING
========================================================= */

searchMode.addEventListener("click", () => {

searchMode.classList.add("active");
generateMode.classList.remove("active");

searchPanel.style.display = "block";
generator.classList.remove("active");

});

generateMode.addEventListener("click", () => {

generateMode.classList.add("active");
searchMode.classList.remove("active");

searchPanel.style.display = "none";
generator.classList.add("active");

});

/* =========================================================
LOCAL AI-STYLE LYRIC GENERATOR
========================================================= */

function generateLyrics(topic, genre, mood) {

if (!topic.trim()) {

    topic = "chasing dreams";

}

const title =
    topic
        .split(" ")
        .map(word =>
            word.charAt(0).toUpperCase() +
            word.slice(1)
        )
        .join(" ");

const lyrics = `

[VERSE 1]

Midnight lights are calling my name,
Running through the city like a runaway flame.
Every little heartbeat keeps pulling me near,
Turning all the silence into something I can hear.

${topic} on my mind tonight,
Neon shadows dancing underneath the lights.
I don't know where tomorrow's gonna go,
But the rhythm in my chest keeps telling me to go.

[PRE-CHORUS]

Oh, we're getting closer,
Feel the moment take control.
Every second burning brighter,
Like a fire in my soul.

[CHORUS]

${title}, take me higher,
Set my heartbeat on fire.
We can lose ourselves tonight,
Underneath these electric lights.

${title}, don't let go,
Follow where the wild winds blow.
If the whole world disappears,
I'll still find you standing here.

[VERSE 2]

City dreams are moving like waves,
Breaking all the rules that we were told to obey.
Every broken road brought me here,
And suddenly the future doesn't feel so unclear.

${topic}, playing in my head,
Words I never said but somehow you read.
Now the night is opening its door,
And I don't wanna be afraid anymore.

[BRIDGE]

Maybe we were meant to find
A little magic in the night.
Maybe every falling star
Was leading us to where we are.

[FINAL CHORUS]

${title}, take me higher,
Set my heartbeat on fire.
We can lose ourselves tonight,
Underneath these electric lights.

${title}, don't let go,
Follow where the wild winds blow.
Turn the volume up again,
Let the music never end.

[OUTRO]

Oh-oh...
The lights are fading slow...

But the rhythm stays alive.

♪ LyricerPixel
`;

return lyrics;

}

/* =========================================================
GENERATE BUTTON
========================================================= */

generateBtn.addEventListener("click", () => {

const topic =
    document.getElementById("topic-input").value;

const genre =
    document.getElementById("genre-input").value;

const mood =
    document.getElementById("mood-input").value;

generateBtn.textContent =
    "⚡ GENERATING...";

statusMsg.textContent =
    `🎛️ Synthesizing ${mood.toLowerCase()} ${genre} lyrics...`;

statusMsg.classList.add("typing");

contentGrid.classList.remove("active");

setTimeout(() => {

    const lyrics =
        generateLyrics(topic, genre, mood);

    lyricsContent.textContent =
        lyrics;

    songTitle.textContent =
        topic
        ? topic
        : "Untitled Frequency";

    songArtist.textContent =
        `${genre} • ${mood}`;

    videoFrame.src = "";

    statusMsg.textContent =
        "✨ Lyrics successfully generated.";

    statusMsg.classList.remove("typing");

    contentGrid.classList.add("active");

    generateBtn.textContent =
        "✨ GENERATE LYRICS";

}, 1200);

});

/* =========================================================
SONG SEARCH
========================================================= */

searchBtn.addEventListener("click", searchSong);

searchInput.addEventListener("keydown", event => {

if (event.key === "Enter") {
    searchSong();
}

});

function searchSong() {

const query =
    searchInput.value.trim();

if (!query) {

    statusMsg.textContent =
        "⚠️ Enter a song or artist first.";

    return;
}

statusMsg.textContent =
    `🔎 Searching music database for "${query}"...`;

statusMsg.classList.add("typing");

contentGrid.classList.remove("active");

/*
   Demo search result.

   Replace this section with your music/video API
   when you connect a real backend.
*/

setTimeout(() => {

    songTitle.textContent = query;

    songArtist.textContent =
        "Search Result";

    lyricsContent.textContent =

`Lyrics for "${query}" will appear here.

Connect your preferred lyrics API to retrieve
licensed lyrics for real songs.

For generated lyrics, switch to
✨ Generate Lyrics mode.`;

    statusMsg.textContent =
        "🎵 Music node synchronized.";

    statusMsg.classList.remove("typing");

    contentGrid.classList.add("active");

}, 900);

}

/* =========================================================
COPY LYRICS
========================================================= */

document.getElementById("copy-btn")
.addEventListener("click", async () => {

const text =
    lyricsContent.innerText;

try {

    await navigator.clipboard.writeText(text);

    document.getElementById("copy-btn")
        .textContent = "✅ Copied!";

    setTimeout(() => {

        document.getElementById("copy-btn")
            .textContent = "📋 Copy";

    }, 1500);

} catch {

    alert("Unable to copy lyrics.");

}

});

/* =========================================================
DOWNLOAD LYRICS
========================================================= */

document.getElementById("download-btn")
.addEventListener("click", () => {

const text =
    lyricsContent.innerText;

const blob =
    new Blob([text], {
        type: "text/plain"
    });

const url =
    URL.createObjectURL(blob);

const link =
    document.createElement("a");

link.href = url;

link.download =
    "lyricerpixel-lyrics.txt";

link.click();

URL.revokeObjectURL(url);

});

</script>
